@using BasicBlazorLibrary.Components.BaseClasses
@using BasicBlazorLibrary.Components.Modals
@inherits PopupBase

<DynamicComponent Type="@typeof(PopupCornered)"
                  Parameters="@PopupParameters" />

@code {
    private IDictionary<string, object> PopupParameters =>
        new Dictionary<string, object>
        {
            [nameof(PopupCornered.CornerPosition)] =
                EnumCornerPosition.TopRight,
            [nameof(PopupCornered.Visible)] = Visible,
            [nameof(PopupCornered.VisibleChanged)] = VisibleChanged,
            [nameof(PopupCornered.DisableBackgroundClick)] = false,
            [nameof(PopupCornered.Margins)] = "10px",
            [nameof(PopupCornered.BackgroundColor)] = "black",
            [nameof(PopupCornered.FullScreen)] = false,
            [nameof(PopupCornered.ShowHeader)] = false,
            [nameof(PopupCornered.ZIndex)] = 6000,
            [nameof(PopupCornered.Style)] = GetMainStyle(),
            [nameof(PopupCornered.Width)] = Width,
            [nameof(PopupCornered.Height)] = Height,
            [nameof(PopupCornered.ChildContent)] = MenuContent
        };

    private RenderFragment MenuContent => @<text>
        @foreach (var item in MenuList)
        {
            @if (ItemHeight == "")
            {
                <div class="clickable"
                     @onclick="async () => await ClickMenuAsync(item)">
                    @item.Text
                </div>
            }
            else
            {
                <div style="height: @ItemHeight"
                     class="clickable"
                     @onclick="async () => await ClickMenuAsync(item)">
                    @item.Text
                </div>
            }
        }
    </text>;
}